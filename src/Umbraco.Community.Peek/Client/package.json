{
  "name": "umbraco-community-peek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "watch": "tsc && vite build --watch",
    "check": "tsc --noEmit",
    "generate-client": "echo \"Point this at a running site once you want a generated OpenAPI client: npx @hey-api/openapi-ts -i https://localhost:44339/umbraco/openapi/peek.json -o src/api/generated\"",
    "test": "node --import ./test/register.mjs --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@umbraco-cms/backoffice": "^18.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
