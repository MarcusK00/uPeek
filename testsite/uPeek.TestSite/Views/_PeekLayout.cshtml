@using Umbraco.Cms.Core.Strings
@using uPeek.TestSite.Demo
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var culture = UmbracoContext?.PublishedRequest?.Culture;
}
<!DOCTYPE html>
<html lang="@(culture ?? "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Name</title>
    <style>
        :root { color-scheme: light dark; --ink: #17171c; --paper: #fdfdfb; --dim: #5f5f6b; --line: #e3e3e8; --accent: #3544b1; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--paper); color: var(--ink); font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        .wrap { max-width: 68ch; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
        header.site { border-bottom: 1px solid var(--line); }
        header.site .wrap { padding: 1.25rem 1.5rem; display: flex; gap: 1.5rem; align-items: baseline; max-width: 68ch; }
        header.site a { color: var(--dim); text-decoration: none; font-size: .9rem; }
        header.site a:hover { color: var(--accent); }
        header.site strong { font-size: .95rem; }
        h1 { font-size: 2.4rem; line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 1rem; }
        h2 { font-size: 1.35rem; letter-spacing: -0.01em; margin: 2.5rem 0 .5rem; }
        .intro { font-size: 1.15rem; color: var(--dim); margin: 0 0 3rem; }
        .block { padding: 1.5rem 0; border-top: 1px solid var(--line); }
        .block:first-of-type { border-top: none; }
        .hero h2 { font-size: 1.9rem; margin-top: 0; }
        .hero p { font-size: 1.1rem; color: var(--dim); }
        .cta a { display: inline-block; background: var(--accent); color: #fff; padding: .6rem 1.1rem; border-radius: 6px; text-decoration: none; font-weight: 600; }
        footer.site { border-top: 1px solid var(--line); margin-top: 4rem; }
        footer.site .wrap { padding: 2rem 1.5rem; color: var(--dim); font-size: .92rem; }
        .hint { margin-top: 3rem; padding: 1rem 1.2rem; border-left: 3px solid var(--accent); background: color-mix(in srgb, var(--accent) 7%, transparent); font-size: .92rem; }
        code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .88em; }
    </style>
</head>
<body>
<header class="site">
    <div class="wrap">
        <strong>uPeek demo</strong>
        @foreach (var rootPage in Umbraco.ContentAtRoot().Where(c => c.ContentType.Alias != PeekDemoAliases.DocumentTypes.SharedContent))
        {
            <a href="@rootPage.Url(culture: culture)">@rootPage.Name(culture)</a>
            foreach (var child in rootPage.Children().Where(c => c.IsPublished(culture)))
            {
                <a href="@child.Url(culture: culture)">@child.Name(culture)</a>
            }
        }
    </div>
</header>

<main class="wrap">
    @RenderBody()

    <div class="hint">
        <strong>Try it.</strong> Press <code>Ctrl</code>+<code>Shift</code>+<code>U</code>, or use the pill in
        the bottom-right corner, then hover anything above. Nothing appears unless you are signed in to the
        backoffice — an anonymous visitor gets byte-identical HTML.
    </div>
</main>

@{
    var shared = Model.Value<IPublishedContent>(PeekDemoAliases.Properties.SharedFooter);
}
@if (shared is not null)
{
    <footer class="site">
        <div class="wrap">
            @(shared.Value<IHtmlEncodedString>(PeekDemoAliases.Properties.FooterText, culture: culture))
        </div>
    </footer>
}
</body>
</html>
